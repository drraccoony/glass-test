<?xml version="1.0" encoding="utf-8"?>
<!-- One Glass add-on on the Apps tab. Tap the header to open its details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:id="@+id/addon_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/addon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/addon_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/addon_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/addon_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/addon_summary"
            style="@style/Hint" />

        <TextView
            android:id="@+id/addon_error"
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:textColor="@color/bad"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/addon_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addon_remove"
                style="@style/TextButton"
                android:text="Remove" />

            <Button
                android:id="@+id/addon_install"
                style="@style/TextButton"
                android:text="Install" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/addon_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
