<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">
        <Button
            android:id="@+id/viewer_back"
            style="@style/TextButton"
            android:text="Back"
            android:textColor="#FFFFFF" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/viewer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/viewer_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A0A4A8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <dev.glassrevival.companion.ZoomImageView
            android:id="@+id/viewer_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <VideoView
            android:id="@+id/viewer_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/viewer_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B0000000"
            android:orientation="vertical"
            android:padding="16dp">
            <ProgressBar
                android:id="@+id/viewer_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:max="100" />
            <TextView
                android:id="@+id/viewer_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Asking Glass for the file"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:orientation="horizontal">
        <Button
            android:id="@+id/viewer_save"
            style="@style/TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Save" />
        <Button
            android:id="@+id/viewer_share"
            style="@style/TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Share" />
        <Button
            android:id="@+id/viewer_delete"
            style="@style/TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Delete" />
        <Button
            android:id="@+id/viewer_info"
            style="@style/TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Info" />
    </LinearLayout>
</LinearLayout>
