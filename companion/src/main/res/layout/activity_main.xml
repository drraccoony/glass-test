<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_detail"
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <!-- Step 1 -->
        <TextView style="@style/Section" android:text="1. Permissions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notif_access_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp" />
            <Button
                android:id="@+id/notif_access_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/bt_perm_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp" />
            <Button
                android:id="@+id/bt_perm_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allow" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:text="If notification access is greyed out, open App info for GlassLink, tap the three-dot menu and choose Allow restricted settings. Installing with adb avoids this." />

        <!-- Step 2 -->
        <TextView style="@style/Section" android:text="2. Your Glass" />

        <TextView
            style="@style/Hint"
            android:text="Open GlassLink on Glass. Its first card shows the Glass address and a six-digit pair code." />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Glass address, e.g. F8:8F:CA:12:34:56"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="17"
            android:singleLine="true" />

        <Button
            android:id="@+id/choose_paired"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose from paired devices" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pair code"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:singleLine="true" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Save and connect" />

        <!-- Step 3 -->
        <TextView style="@style/Section" android:text="3. Forwarding" />

        <Switch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Send notifications to Glass"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send test" />
            <Button
                android:id="@+id/muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Muted apps" />
        </LinearLayout>

        <Button
            android:id="@+id/quick_replies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick replies" />

        <!-- Step 4 -->
        <TextView style="@style/Section" android:text="4. Weather" />

        <Switch
            android:id="@+id/weather_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Show weather on Glass"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/weather_fahrenheit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Use Fahrenheit (&#176;F)"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp" />
            <Button
                android:id="@+id/weather_place_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weather_location_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_location_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp" />
            <Button
                android:id="@+id/weather_location_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allow" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_status"
            style="@style/Hint"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/weather_refresh"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update now" />

        <!-- Step 5 -->
        <TextView style="@style/Section" android:text="5. Airport weather (METAR)" />

        <Switch
            android:id="@+id/metar_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Show METARs on Glass"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/metar_airports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Airports, comma separated, e.g. KLVN, KMSP"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/metar_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save airports" />

        <TextView
            android:id="@+id/metar_status"
            style="@style/Hint"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="12dp"
            android:text="Ongoing notifications (music, downloads, navigation) and anything an app marks as phone-only are not sent. Dismissing a card on Glass clears it on the phone too. Messages from apps with a reply button can be answered from Glass." />
    </LinearLayout>
</ScrollView>
