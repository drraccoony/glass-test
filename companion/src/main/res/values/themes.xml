<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#1A88E0</color>
    <color name="ok">#3D9A3D</color>
    <color name="bad">#C23B3B</color>
    <color name="muted_text">#757575</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#1A6FB8</item>
        <item name="android:colorPrimaryDark">#14578F</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted_text</item>
    </style>
</resources>
