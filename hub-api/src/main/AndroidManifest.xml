<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    Only apps signed with the same key as GlassLink can use the hub. Every app that
    includes this library both defines and requests the permission, so install order
    doesn't matter (Android 4.4 never grants a permission defined after install).
    -->
    <permission
        android:name="dev.glassrevival.permission.HUB"
        android:label="Use the GlassLink connection"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.glassrevival.permission.HUB" />

    <!-- Android 11+ package visibility: find the hub and the apps that receive messages. -->
    <queries>
        <intent>
            <action android:name="dev.glassrevival.hub.action.BIND" />
        </intent>
        <intent>
            <action android:name="dev.glassrevival.hub.action.MESSAGE" />
        </intent>
    </queries>
</manifest>
