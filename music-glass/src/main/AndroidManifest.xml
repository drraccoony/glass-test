<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_music"
        android:label="@string/app_name">

        <uses-library
            android:name="com.google.android.glass"
            android:required="true" />

        <!-- Owns the live card while something plays on the phone. -->
        <service
            android:name=".MusicService"
            android:exported="false" />

        <!-- Woken by the GlassLink hub when the phone starts playing. -->
        <receiver
            android:name=".MusicReceiver"
            android:exported="true"
            android:permission="dev.glassrevival.permission.HUB">
            <intent-filter>
                <action android:name="dev.glassrevival.hub.action.MESSAGE" />
            </intent-filter>
            <meta-data
                android:name="dev.glassrevival.hub.CHANNELS"
                android:value="dev.glassrevival.music" />
        </receiver>

        <!-- "ok glass, listen to": shows the card even when nothing is playing. -->
        <activity
            android:name=".MusicLaunchActivity"
            android:exported="true"
            android:theme="@style/MenuTheme">
            <intent-filter>
                <action android:name="com.google.android.glass.action.VOICE_TRIGGER" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.glass.VoiceTrigger"
                android:resource="@xml/voice_trigger" />
        </activity>

        <!-- The menu shown when the live card is tapped. -->
        <activity
            android:name=".MusicMenuActivity"
            android:exported="false"
            android:theme="@style/MenuTheme" />
    </application>
</manifest>
